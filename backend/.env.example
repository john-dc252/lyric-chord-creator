DATABASE_URL=postgres://lcc:lcc@localhost:5432/lcc
BIND_ADDR=127.0.0.1:8080
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Sessions expire after this much inactivity, or this long after sign-in
SESSION_IDLE_HOURS=168
SESSION_MAX_AGE_DAYS=90

# Externally reachable URL of this API (callback URLs are built from it)
PUBLIC_URL=http://localhost:8080/
# Where the browser lands after sign-in (gets ?login_code=…&client_state=… or ?login_error=…)
FRONTEND_URL=http://localhost:3000/apps/lyric-chord-creator/

# JSON list of OpenID Connect providers. Register {PUBLIC_URL}auth/{name}/callback with each.
# OIDC_PROVIDERS=[{"name":"google","label":"Google","issuer":"https://accounts.google.com","clientId":"…","clientSecret":"…"}]

# Dev only (debug builds): stub sign-in with credentials from this file
STUB_USERS_FILE=dev-users.txt

# Rate limits, requests/minute per user (signed in) or IP; 0 disables a tier
# RATE_LIMIT_SIGN_IN_PER_MINUTE=10
# RATE_LIMIT_AUTH_READ_PER_MINUTE=60
# RATE_LIMIT_TEMPLATE_READ_PER_MINUTE=300
# RATE_LIMIT_TEMPLATE_WRITE_PER_MINUTE=120
# Behind a trusted reverse proxy: header carrying the client IP
# CLIENT_IP_HEADER=x-forwarded-for

RUST_LOG=lyric_chord_backend=debug,tower_http=info
